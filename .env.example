# Local development: copy to .env (`cp .env.example .env`).
# The Supabase values point at the local stack (`supabase start`). The URL and
# publishable key are the Supabase CLI's fixed defaults: the same on every
# machine and only valid against your own local stack.
# Hosted values live in Vercel (and optionally in an untracked .env.hosted).

# Supabase API (`supabase status`: API_URL, PUBLISHABLE_KEY)
PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH

# Server only, bypasses RLS; used by the rig endpoints.
# Paste SECRET_KEY from `pnpm exec supabase status`. It's left empty here because
# GitHub push protection blocks any committed Supabase secret key.
# Never put the hosted key here.
SUPABASE_SERVICE_ROLE_KEY=

# Include laps flagged for_testing in queries. The seed marks a few laps as test laps.
GET_TEST_RECORDS=false

# Minutes of rig inactivity before a session counts as ended.
SESSION_TIMEOUT_MINS=120
